{
  "name": "lorehive",
  "version": "0.1.0",
  "private": true,
  "description": "Shared, poisoning-resistant memory for mixed agent fleets on Atlassian Forge",
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint:forge": "forge lint",
    "deploy": "npm run build:ui && forge deploy",
    "deploy:prod": "npm run build:ui && forge deploy -e production",
    "build:ui": "node static/console/build.mjs"
  },
  "dependencies": {
    "@forge/api": "^8.4.0",
    "@forge/events": "^3.0.9",
    "@forge/llm": "^1.0.9",
    "@forge/resolver": "^2.0.2",
    "@forge/sql": "^4.0.9"
  },
  "devDependencies": {
    "@forge/bridge": "^7.2.1",
    "@forge/cli": "^14.2.0",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
